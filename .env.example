# ============================================================
#  环境变量模板 —— 复制为 .env 后填写真实值
#  app/config.py 会在启动时自动加载项目根目录的 .env
#  （已存在的系统环境变量优先，不会被 .env 覆盖）
#  ⚠️ 真实密钥不要提交到仓库，.env 已在 .gitignore 中
# ============================================================

# ---------- 安全 ----------
# 会话签名密钥；留空时自动生成并写入 .secret_key 文件
SECRET_KEY=

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 口令二选一：这里填，或在项目根目录创建 .db_password 文件（只写口令本身）
DB_PASSWORD=
DB_NAME=userdb

# ---------- AI（不填则走演示模式）----------
# 任意 OpenAI 兼容端点均可：DeepSeek / 智谱 / 通义 / OpenAI / 本地 Ollama
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 多模态模型（留空则复用 AI_MODEL）
AI_VISION_MODEL=
AI_TIMEOUT=60
AI_MAX_TOKENS=1200

# ---------- 审核阈值 ----------
AUDIT_PASS_THRESHOLD=75
AUDIT_MANUAL_THRESHOLD=45

# ---------- 切片审核 ----------
# 每段时长（秒）：视频按时长切成若干段，逐段判定
AUDIT_SEGMENT_SECONDS=4
# 最多切几段（控成本：每段一次多模态调用）
AUDIT_SEGMENT_MAX=6
# 每段取几个代表帧
AUDIT_SEGMENT_PICKS=1

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
# 生产环境务必设为 0
DEBUG=1
# 生成媒体 URL 的前缀；留空则输出 /uploads/... 相对路径
PUBLIC_BASE_URL=

# ---------- 可选功能 ----------
# 1 = 允许注册满 30 天的用户自助成为审核员（仅建议本地演示）
ALLOW_SELF_AUDITOR=0
# 1 = 开放视频推流接口（需同时为审核员）
ENABLE_STREAM_API=0
# 1 = 会话 Cookie 仅在 HTTPS 下发送（站点启用 HTTPS 后打开）
SESSION_COOKIE_SECURE=0
